{
  "name": "changefeed",
  "productName": "Changefeed",
  "version": "1.0.1",
  "upgrade": "pear://7ffucmhbpa7z5hcao4t6435c6ndqryn38iu6nfzqwubqykap15yy",
  "description": "Peer-to-peer release notes: publish once, subscribers keep every note offline.",
  "license": "",
  "author": "Fortune Ikechi",
  "type": "commonjs",
  "main": "electron/main.js",
  "imports": {
    "events": {
      "bare": "bare-events",
      "default": "events"
    },
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "os": {
      "bare": "bare-os",
      "default": "os"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    }
  },
  "private": true,
  "scripts": {
    "lint": "prettier --check . && lunte",
    "format": "prettier --write . && lunte --fix",
    "start": "electron-forge start -- --no-updates",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "install:all": "npm i --ignore-scripts=true && npm run postinstall:all",
    "install:mac": "npm i --ignore-scripts=true && npm run postinstall:mac",
    "postinstall:all": "npm run install:electron",
    "postinstall:mac": "npm run postinstall:all && npm run install:macos-alias && npm run install:fs-xattr",
    "install:electron": "node node_modules/electron/install.js",
    "install:macos-alias": "cd node_modules/macos-alias && node-gyp rebuild",
    "install:fs-xattr": "cd node_modules/fs-xattr && node-gyp rebuild",
    "test": "node scripts/app-bare.js test/two-peers.js && node test/worker-ipc.js && node test/cli.js",
    "cli": "node scripts/app-bare.js cli/bin.mjs"
  },
  "dependencies": {
    "bare-events": "^2.9.2",
    "bare-fs": "^4.8.4",
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.2",
    "bare-process": "^4.5.1",
    "bare-storage": "^1.1.0",
    "corestore": "^7.15.0",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperbee": "^2.27.3",
    "hypercore-id-encoding": "^1.3.0",
    "hyperswarm": "^4.17.2",
    "paparam": "^1.14.0",
    "pear-runtime": "^1.3.1",
    "which-runtime": "^1.4.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-msix": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron/node-gyp": "git+ssh://git@github.com/electron/node-gyp.git#06b29aafb7708acef8b3669835c8a7857ebc92d2",
    "app-builder-lib": "^26.8.1",
    "electron": "^40.2.1",
    "electron-forge-plugin-prune-prebuilds": "^1.0.0",
    "electron-forge-plugin-universal-prebuilds": "^1.0.0",
    "lunte": "^1.6.0",
    "pear-electron-forge-maker-appimage": "^2.0.0",
    "pear-electron-forge-maker-flatpak": "^0.0.6",
    "pear-electron-forge-maker-snap": "^1.0.0",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0"
  },
  "allowScripts": {
    "electron@40.10.1": true,
    "electron-winstaller": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamfortune/Changefeed.git"
  }
}
